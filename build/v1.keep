      <span class="foot__soc">
        <a href="#" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 3h3l-6.6 7.5L21.7 21h-6l-4.7-6.1L5.6 21h-3l7-8L2.5 3h6.2l4.2 5.6L17.5 3Z"/></svg></a>
        <a href="#" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05a4.2 4.2 0 0 1 3.75-2c4 0 4.75 2.6 4.75 6V21h-4v-5.5c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9V21h-4V9Z"/></svg></a>
        <a href="https://docs.callem.ai/" target="_blank" rel="noopener" aria-label="Documentation"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-api"/></svg></a>
      </span>
    </div>
  </div>
</footer>
</div>

<script>
(function(){
"use strict";
var RM = matchMedia("(prefers-reduced-motion: reduce)").matches;
var $ = function(s){ return document.getElementById(s); };

/* ── NAV : pilule sombre sur le héros, claire ensuite ──────────────────── */
var nav = $("nav"), burger = $("burger");
function navState(){ nav.classList.toggle("is-tight", scrollY > 90); }
addEventListener("scroll", navState, {passive:true}); navState();
burger.addEventListener("click", function(){
  var open = nav.classList.toggle("is-open");
  burger.setAttribute("aria-expanded", open);
  burger.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
});
document.querySelectorAll(".nav__mob a").forEach(function(a){
  a.addEventListener("click", function(){ nav.classList.remove("is-open"); burger.setAttribute("aria-expanded","false"); });
});

/* ── RÉVÉLATION ────────────────────────────────────────────────────────── */
var io = new IntersectionObserver(function(es){
  es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add("is-in"); io.unobserve(e.target); } });
}, {rootMargin:"0px 0px -10% 0px", threshold:.06});
document.querySelectorAll(".rv,#sovPanel").forEach(function(el){ io.observe(el); });

/* ── COMPTEURS ─────────────────────────────────────────────────────────── */
var cio = new IntersectionObserver(function(es){
  es.forEach(function(e){
    if(!e.isIntersecting) return;
    cio.unobserve(e.target);
    var el = e.target, to = +el.dataset.to, pre = el.dataset.pre||"", suf = el.dataset.suf||"";
    if (RM){ el.innerHTML = pre + to + suf; return; }
    var t0 = performance.now();
    (function step(t){
      var k = Math.min(1,(t-t0)/1250), e2 = 1-Math.pow(1-k,3);
      el.innerHTML = pre + Math.round(to*e2) + suf;
      if(k<1) requestAnimationFrame(step);
    })(t0);
  });
}, {threshold:.5});
document.querySelectorAll("[data-to]").forEach(function(el){ cio.observe(el); });

/* ── LOGOS ─────────────────────────────────────────────────────────────── */
var VB = {openai:"0 0 120 24",anthropic:"0 0 128 24",mistral:"0 0 118 24",googlecloud:"0 0 150 24",
  elevenlabs:"0 0 130 24",azure:"0 0 120 24",salesforce:"0 0 136 24",hubspot:"0 0 126 24",
  twilio:"0 0 110 24",zapier:"0 0 108 24",calcom:"0 0 106 24",genesys:"0 0 116 24",zendesk:"0 0 116 24",
  servicenow:"0 0 140 24",pipedrive:"0 0 122 24",zoho:"0 0 110 24",attio:"0 0 96 24",close:"0 0 100 24",
  nice:"0 0 118 24",five9:"0 0 98 24",talkdesk:"0 0 118 24",cisco:"0 0 102 24",slack:"0 0 100 24"};
var NAMES = {openai:"OpenAI",anthropic:"Anthropic",mistral:"Mistral AI",googlecloud:"Google Cloud",
  elevenlabs:"ElevenLabs",azure:"Microsoft Azure",salesforce:"Salesforce",hubspot:"HubSpot",
  twilio:"Twilio",zapier:"Zapier",calcom:"Cal.com",genesys:"Genesys",zendesk:"Zendesk",
  servicenow:"ServiceNow",pipedrive:"Pipedrive",zoho:"Zoho CRM",attio:"Attio",close:"Close",
  nice:"NICE CXone",five9:"Five9",talkdesk:"Talkdesk",cisco:"Cisco",slack:"Slack"};
var BRANDS = Object.keys(VB);
function logo(k){ return '<svg viewBox="'+VB[k]+'" role="img" aria-label="'+NAMES[k]+'"><use href="#lg-'+k+'"/></svg>'; }

$("trustedG").innerHTML = ["openai","anthropic","mistral","googlecloud","elevenlabs","azure"]
  .map(function(k){ return "<span>"+logo(k)+"</span>"; }).join("");

var A = BRANDS.slice(0,12), B = BRANDS.slice(12).concat(BRANDS.slice(0,5));
function tiles(list){ return list.map(function(k){ return '<span class="tile">'+logo(k)+'</span>'; }).join(""); }
$("mqA").innerHTML = tiles(A) + tiles(A);
$("mqB").innerHTML = tiles(B) + tiles(B);

$("spark").innerHTML = [38,62,44,78,52,70,48,86,58,40,74,54,66,46]
  .map(function(h){ return '<i style="--h:'+h+'%"></i>'; }).join("");

/* ── EXPLORATEUR : accordéon + panneau synchronisé ─────────────────────── */
var items = [].slice.call(document.querySelectorAll(".exp__i")),
    panes = [].slice.call(document.querySelectorAll(".pane")),
    bar = $("expBar"), open = 0;
function openItem(n){
  open = n;
  items.forEach(function(it,i){
    var on = i===n, p = it.querySelector(".exp__p");
    it.setAttribute("aria-expanded", on ? "true" : "false");
    p.style.height = on ? p.scrollHeight + "px" : "0px";
  });
  panes.forEach(function(p,i){ p.classList.toggle("on", i===n); });
  bar.style.top = items[n].offsetTop + "px";
  bar.style.height = items[n].offsetHeight + "px";
}
items.forEach(function(it,i){ it.addEventListener("click", function(){ openItem(i); }); });
addEventListener("resize", function(){ openItem(open); });
requestAnimationFrame(function(){ openItem(0); });
setTimeout(function(){ openItem(0); }, 500);
if (document.fonts && document.fonts.ready) document.fonts.ready.then(function(){ openItem(open); });

/* ── HÉROS : le ruban de voix, animé en permanence ────────────────────── */
var hero = $("hero"), pin = $("heroPin"), rail = $("heroRail"), copy = $("heroCopy"),
    payoff = $("payoff"), listen = $("listen"), listenT = $("listenT"),
    cv = $("ribbon"), ctx = cv.getContext("2d"),
    acts = [].slice.call(document.querySelectorAll(".act")),
    cds  = [].slice.call(document.querySelectorAll(".cd"));

function clamp01(v){ return v<0?0:v>1?1:v; }
function ease(k){ return k<.5 ? 4*k*k*k : 1-Math.pow(-2*k+2,3)/2; }
function seg(p,a,b){ return ease(clamp01((p-a)/(b-a))); }
function lerp(a,b,k){ return a+(b-a)*k; }

/* ── le ruban : N brins qui ondulent, dessinés au canevas ── */
var NS = 15, W = 0, H = 0, DPR = 1, prog = 0, shown = 0, live = true;
var STR = [];
for (var i=0;i<NS;i++){
  var t = i/(NS-1);
  STR.push({
    off:(t-.5),                       /* écart vertical */
    ph:t*7.3,                         /* déphasage */
    sp:.55 + t*.5,                    /* vitesse propre */
    amp:.62 + Math.sin(t*3.1)*.34,    /* amplitude propre */
    wid:1.1 + (1-Math.abs(t-.5)*2)*2.6,
    hue:t                              /* position dans le dégradé */
  });
}
function size(){
  var r = pin.getBoundingClientRect();
  DPR = Math.min(1.75, devicePixelRatio||1);
  W = Math.max(1, r.width); H = Math.max(1, r.height);
  cv.width = W*DPR; cv.height = H*DPR;
  ctx.setTransform(DPR,0,0,DPR,0,0);
}
function mix(a,b,k){
  return "rgb("+Math.round(lerp(a[0],b[0],k))+","+Math.round(lerp(a[1],b[1],k))+","+Math.round(lerp(a[2],b[2],k))+")";
}
var CA = [235,106,10], CB = [139,60,247];

function draw(now){
  requestAnimationFrame(draw);
  if(!live) return;
  var t = now*.001, p = shown;
  ctx.clearRect(0,0,W,H);

  /* le ruban se resserre puis se concentre à mesure qu'on avance */
  var spread = lerp(1, .18, seg(p,.10,.72));
  var amp    = lerp(1, .42, seg(p,.30,.78));
  var cx     = lerp(W*.60, W*.54, seg(p,0,1));
  var cy     = H*.48;
  var span   = W*.92;
  var gap    = H*.052;

  ctx.lineCap = "round";
  for (var i=0;i<NS;i++){
    var S = STR[i];
    ctx.beginPath();
    var steps = 58;
    for (var j=0;j<=steps;j++){
      var u = j/steps;                        /* 0..1 le long du ruban */
      var x = cx - span/2 + u*span;
      var env = Math.exp(-Math.pow((u-.5)*2.25,2));   /* cloche : effilé aux bouts */
      var y = cy + S.off*gap*NS*.5*spread*env*1.15
            + env*amp*H*.13*S.amp*(
                Math.sin(u*5.6 + t*S.sp + S.ph) +
                .55*Math.sin(u*11.2 - t*S.sp*1.4 + S.ph*1.7) +
                .3*Math.sin(u*2.3 + t*.4 + S.ph*.6));
      if(j===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
    }
    ctx.strokeStyle = mix(CA, CB, S.hue);
    ctx.globalAlpha = .16 + .3*(1-Math.abs(S.hue-.5)*2) + .18*seg(p,.4,.9);
    ctx.lineWidth = S.wid*(1+.5*seg(p,.4,.9));
    ctx.stroke();
  }

  /* impulsion lumineuse qui parcourt le ruban : le signal vocal */
  var pu = (t*.34)%1;
  var px = cx - span/2 + pu*span;
  var envp = Math.exp(-Math.pow((pu-.5)*2.25,2));
  var py = cy + envp*amp*H*.13*(Math.sin(pu*5.6+t*.8)+.55*Math.sin(pu*11.2-t*1.1));
  var g = ctx.createRadialGradient(px,py,0,px,py,Math.min(140,W*.09));
  g.addColorStop(0,"rgba(235,106,10,.34)"); g.addColorStop(1,"rgba(235,106,10,0)");
  ctx.globalAlpha = 1; ctx.fillStyle = g;
  ctx.beginPath(); ctx.arc(px,py,Math.min(140,W*.09),0,6.283); ctx.fill();
  ctx.globalAlpha = 1;
}

/* ── positions des cartes, calées sur le ruban ── */
/* a = ancrage : "l" cale à gauche, "r" cale à droite pour ne jamais déborder */
var SLOT = [
  {a:"l", x:.505, y:.235}, {a:"r", x:.035, y:.40}, {a:"l", x:.495, y:.60},
  {a:"r", x:.045, y:.735}, {a:"l", x:.515, y:.845}
];
var shot = document.getElementById("shot");
function layout(p){
  var pw = pin.clientWidth, ph = pin.clientHeight;
  cds.forEach(function(el,i){
    var s = SLOT[i];
    if (s.a === "r"){ el.style.right = (pw*s.x)+"px"; el.style.left = "auto"; }
    else { el.style.left = (pw*s.x)+"px"; el.style.right = "auto"; }
    el.style.top = (ph*s.y) + "px";
  });
  /* la photo : grand panneau à droite qui se resserre au fil du récit */
  var sw = lerp(pw*.40, pw*.30, seg(p,.30,.86));
  var sh = lerp(ph*.70, ph*.54, seg(p,.30,.86));
  var scx = lerp(pw*.735, pw*.755, seg(p,0,1)), scy = ph*.46;
  shot.style.width = sw+"px"; shot.style.height = sh+"px";
  shot.style.left = (scx-sw/2)+"px"; shot.style.top = (scy-sh/2)+"px";
  shot.style.borderRadius = lerp(30,26,seg(p,.3,.9))+"px";

  listen.style.left = (pw*.505) + "px";
  listen.style.top  = (ph*.135) + "px";
  payoff.style.left = scx + "px";
  payoff.style.top  = (scy + sh/2 + Math.min(34, ph*.045)) + "px";

  var fade = 1 - seg(p,.52,.70);
  copy.style.opacity = fade;
  copy.style.transform = "translateY(" + (-24*(1-fade)) + "px)";
  copy.style.pointerEvents = fade < .1 ? "none" : "auto";
  listen.style.opacity = 1 - seg(p,.74,.86);
}

var LTXT = ["à l’écoute · fr-FR","intention : suivi de commande","exécution des outils","appel clôturé"];
var STEP_MS = 2600, cur = 0, timer = null, held = false;
var actBtns = [].slice.call(document.querySelectorAll(".act"));

/* n = nombre d'éléments révélés (0 à 5) ; l'acte courant en découle */
function render(n){
  cur = n;
  cds.forEach(function(el,i){ el.classList.toggle("on", i < n); });
  cds.forEach(function(el,i){ el.style.opacity = (n===5 && i<4) ? "0" : ""; });
  var act = n <= 1 ? 0 : n <= 2 ? 1 : n <= 4 ? 2 : 3;
  hero.classList.toggle("p3", n >= 5);
  actBtns.forEach(function(b,i){
    b.classList.toggle("on", i === act);
    b.classList.toggle("past", i < act);
    b.style.setProperty("--dur", STEP_MS + "ms");
  });
  if (listenT) listenT.textContent = LTXT[act];
}

/* la vidéo du héros : on force la lecture, Chrome la suspend parfois */
var vid = document.getElementById("heroVid");
var vidWanted = true;
function playVid(){ if (vid && vid.paused) { var q = vid.play(); if (q && q.catch) q.catch(function(){}); } }
function pauseVid(){ vidWanted = false; if (vid && !vid.paused) vid.pause(); }
if (vid){
  ["loadeddata","canplay"].forEach(function(e){
    vid.addEventListener(e, function(){ if(!document.hidden) playVid(); });
  });
  playVid();
  /* certains navigateurs suspendent la lecture : on réessaie doucement */
  setInterval(function(){ if(!document.hidden && vidWanted) playVid(); }, 1500);
}

function advance(){ render(cur >= 5 ? 1 : cur + 1); }
function play(){
  vidWanted = true; playVid();
  if (timer || RM) return;
  timer = setInterval(function(){ if(!held) advance(); }, STEP_MS);
}
function stop(){ clearInterval(timer); timer = null; pauseVid(); }

/* on met en pause quand le héros sort de l'écran ou que l'onglet est caché */
new IntersectionObserver(function(es){ es[0].isIntersecting ? play() : stop(); },
  {threshold:0}).observe(document.getElementById("heroPin"));
document.addEventListener("visibilitychange", function(){ document.hidden ? stop() : play(); });
addEventListener("pointerdown", playVid, {once:true});

/* interaction : survol = pause, clic sur un acte = saut direct */
var pinEl = document.getElementById("heroPin");
pinEl.addEventListener("pointerenter", function(){ held = true; });
pinEl.addEventListener("pointerleave", function(){ held = false; });
actBtns.forEach(function(b,i){
  b.addEventListener("click", function(){
    render([1,2,4,5][i]);
    stop(); play();
  });
});

function paint(p){ /* le scroll ne pilote plus le récit : il joue seul */ }

function onScroll(){
  var r = rail.getBoundingClientRect(), sp = r.height - innerHeight;
  prog = clamp01(sp > 0 ? (-r.top)/sp/.94 : 0);
  layout(prog); paint(prog);
}

function goStatic(){
  hero.classList.add("static","p3");
  copy.style.cssText = ""; payoff.style.cssText = ""; listen.style.cssText = "";
  cds.forEach(function(el){ el.style.cssText = ""; });
  size();

}

size();
addEventListener("resize", function(){ size(); if(!hero.classList.contains("static")) onScroll(); });
if (RM || matchMedia("(max-width:1024px)").matches){ goStatic(); shown = 1; }
else { addEventListener("scroll", onScroll, {passive:true}); onScroll(); }
render(RM ? 5 : 1);
if (!RM) play();
(function follow(){ shown += (prog-shown)*.12; requestAnimationFrame(follow); })();
requestAnimationFrame(draw);
document.addEventListener("visibilitychange", function(){ live = !document.hidden; });
new IntersectionObserver(function(es){ live = es[0].isIntersecting && !document.hidden; },
  {threshold:0}).observe(pin);

/* ── FORMULAIRE (UI seule — branchement e-mail à venir) ─────────────────── */
var form = $("demoForm"), box = $("demoBox"), done = $("done");
function bad(el, on){ el.closest(".f").classList.toggle("is-bad", on); return !on; }
form.addEventListener("submit", function(e){
  e.preventDefault();
  var ok = true, nom = form.nom, soc = form.societe, mail = form.email, tel = form.telephone;
  ok = bad(nom, nom.value.trim().length < 2) && ok;
  ok = bad(soc, soc.value.trim().length < 2) && ok;
  ok = bad(mail, !/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(mail.value.trim())) && ok;
  ok = bad(tel, tel.value.replace(/[^0-9+]/g,"").length < 9) && ok;
  if(!ok){ form.querySelector(".is-bad input").focus(); return; }
  /* TODO — brancher ici l'envoi vers hamzaghouili@callem.ai (fonction serverless) */
  box.classList.add("is-sent"); done.classList.add("is-on");
  done.scrollIntoView({block:"center", behavior: RM ? "auto" : "smooth"});
});
form.querySelectorAll("input").forEach(function(el){
  el.addEventListener("input", function(){ el.closest(".f").classList.remove("is-bad"); });
});
})();
</script>

<script>
/* ══════════════════════════════════════════════════════════════════════════
   COUCHE MOUVEMENT — GSAP · ScrollTrigger · Lenis · Swiper · SplitType
   ══════════════════════════════════════════════════════════════════════════ */
window.addEventListener("load", function(){
  var RM = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (RM || !window.gsap || !window.ScrollTrigger) return;
  gsap.registerPlugin(ScrollTrigger);

  /* ── 1. défilement inertiel (Lenis) branché sur ScrollTrigger ─────────── */
  var lenis = null;
  if (window.Lenis && !matchMedia("(hover:none)").matches){
    lenis = new Lenis({ duration:1.05, smoothWheel:true, wheelMultiplier:.95 });
    lenis.on("scroll", ScrollTrigger.update);
    gsap.ticker.add(function(t){ lenis.raf(t*1000); });
    gsap.ticker.lagSmoothing(0);
    document.querySelectorAll('a[href^="#"]').forEach(function(a){
      a.addEventListener("click", function(e){
        var el = document.querySelector(a.getAttribute("href"));
        if (el){ e.preventDefault(); lenis.scrollTo(el, {offset:-90}); }
      });
    });
  }

  /* ── 2. jauge de progression ──────────────────────────────────────────── */
  var prog = document.createElement("div");
  prog.className = "prog";
  document.body.appendChild(prog);
  gsap.to(prog, {scaleX:1, ease:"none",
    scrollTrigger:{trigger:document.body, start:"top top", end:"bottom bottom", scrub:.3}});

  /* ── 3. titres révélés mot par mot ────────────────────────────────────── */
  if (window.SplitType){
    document.querySelectorAll("h2").forEach(function(h){
      if (h.closest(".hero")) return;
      h.classList.add("split");
      var st = new SplitType(h, {types:"words", wordClass:"word"});
      st.words.forEach(function(w){
        var inner = document.createElement("span");
        while (w.firstChild) inner.appendChild(w.firstChild);
        w.appendChild(inner);
      });
      gsap.from(h.querySelectorAll(".word>span"), {
        yPercent:118, duration:.85, ease:"power3.out", stagger:.045,
        scrollTrigger:{trigger:h, start:"top 86%", once:true}
      });
    });
  }

  /* ── 4. apparition en cascade des blocs ───────────────────────────────── */
  ScrollTrigger.batch(".sect__i, .story__i, .tri__i, .fact, .stats__i, .tile, .exp__i, .comp__i", {
    start:"top 90%", once:true,
    onEnter:function(els){
      gsap.from(els, {y:34, opacity:0, duration:.75, ease:"power3.out", stagger:.07, overwrite:true});
    }
  });

  /* ── 5. parallaxe sur toutes les photos ───────────────────────────────── */
  document.querySelectorAll(".pic img, .sov__img, .demo__img").forEach(function(im){
    gsap.fromTo(im, {yPercent:-7}, {yPercent:7, ease:"none",
      scrollTrigger:{trigger:im.closest("*"), start:"top bottom", end:"bottom top", scrub:.6}});
  });

  /* ── 6. compteurs ─────────────────────────────────────────────────────── */
  document.querySelectorAll("[data-to]").forEach(function(el){
    var to = +el.dataset.to, pre = el.dataset.pre||"", suf = el.dataset.suf||"", o = {v:0};
    gsap.to(o, {v:to, duration:1.4, ease:"power2.out",
      scrollTrigger:{trigger:el, start:"top 88%", once:true},
      onUpdate:function(){ el.innerHTML = pre + Math.round(o.v) + suf; }});
  });

  /* ── 7. cartes en relief au survol ────────────────────────────────────── */
  document.querySelectorAll(".sect__i, .story__i, .tri__i").forEach(function(c){
    c.classList.add("tilt");
    var rx = gsap.quickTo(c, "rotationX", {duration:.5, ease:"power3"}),
        ry = gsap.quickTo(c, "rotationY", {duration:.5, ease:"power3"}),
        sc = gsap.quickTo(c, "scale", {duration:.5, ease:"power3"});
    c.addEventListener("pointermove", function(e){
      var b = c.getBoundingClientRect();
      rx(((e.clientY-b.top)/b.height - .5) * -8);
      ry(((e.clientX-b.left)/b.width - .5) * 10);
      sc(1.02);
    });
    c.addEventListener("pointerleave", function(){ rx(0); ry(0); sc(1); });
  });
  gsap.set(".sect__i, .story__i, .tri__i", {transformPerspective:900});

  /* ── 8. boutons magnétiques ───────────────────────────────────────────── */
  document.querySelectorAll(".btn--accent, .btn--primary, .sw-btn").forEach(function(b){
    b.classList.add("mag");
    var x = gsap.quickTo(b, "x", {duration:.45, ease:"power3"}),
        y = gsap.quickTo(b, "y", {duration:.45, ease:"power3"});
    b.addEventListener("pointermove", function(e){
      var r = b.getBoundingClientRect();
      x((e.clientX - (r.left+r.width/2)) * .28);
      y((e.clientY - (r.top+r.height/2)) * .38);
    });
    b.addEventListener("pointerleave", function(){ x(0); y(0); });
  });

  /* ── 9. bandeaux de logos pilotés par la vitesse de défilement ────────── */
  document.querySelectorAll(".mq").forEach(function(m, i){
    var track = m.querySelector(".mq__t");
    if (!track) return;
    track.style.animation = "none";
    var dir = i % 2 ? 1 : -1;
    var tl = gsap.to(track, {xPercent: dir * -50, duration: 34, ease:"none", repeat:-1});
    if (dir > 0) gsap.set(track, {xPercent:-50});
    ScrollTrigger.create({
      onUpdate:function(self){
        var v = 1 + Math.min(6, Math.abs(self.getVelocity()) / 320);
        gsap.to(tl, {timeScale: v, duration:.3, overwrite:true});
        gsap.to(tl, {timeScale: 1, duration:.9, delay:.3, overwrite:false});
      }
    });
    m.addEventListener("pointerenter", function(){ gsap.to(tl, {timeScale:.25, duration:.4}); });
    m.addEventListener("pointerleave", function(){ gsap.to(tl, {timeScale:1, duration:.4}); });
  });

  /* ── 10. carrousels Swiper ────────────────────────────────────────────── */
  function carousel(root){
    if (!window.Swiper) return;
    var bar = root.parentElement.querySelector(".sw-bar i");
    var ui  = root.parentElement.querySelector(".sw-ui");
    /* quand toutes les cartes tiennent à l'écran, Swiper se verrouille : on retire les commandes */
    function sync(s){ if (ui) ui.style.display = s.isLocked ? "none" : ""; }
    var sw = new Swiper(root, {
      slidesPerView:"auto", spaceBetween:14, grabCursor:true, freeMode:{enabled:true, sticky:false},
      speed:520, threshold:4,
      navigation:{ nextEl: root.parentElement.querySelector(".sw-next"),
                   prevEl: root.parentElement.querySelector(".sw-prev") },
      on:{ progress:function(s, p){ if (bar) gsap.to(bar, {scaleX: .3 + p*.7, x: (p*100)+"%", duration:.3}); },
           init:function(s){ if (bar) gsap.set(bar, {scaleX:.3}); sync(s); },
           resize:sync, breakpoint:sync }
    });
    return sw;
  }
  document.querySelectorAll(".sw").forEach(carousel);

  /* ── 11. le héros se dépose en douceur ────────────────────────────────── */
  var shot = document.getElementById("shot");
  if (shot){
    gsap.from(shot, {scale:.94, opacity:0, duration:1.1, ease:"power3.out", delay:.15});
    gsap.from(".hero__copy > *", {y:26, opacity:0, duration:.8, ease:"power3.out", stagger:.09, delay:.05});
  }

  ScrollTrigger.refresh();
});
</script>

<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Organization","name":"Callem","url":"https://callem.ai/",
"description":"Agents vocaux IA souverains, hébergés en France.","email":"contact@callem.ai",
"address":{"@type":"PostalAddress","streetAddress":"12 rue de la Voix","postalCode":"75011","addressLocality":"Paris","addressCountry":"FR"}}
</script>
</body>
</html>
