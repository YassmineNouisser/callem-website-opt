<!-- ═══ PLATEFORME ══════════════════════════════════════════════════════ -->
<section class="sec sec--cream" id="plateforme">
  <div class="wrap">
    <div class="sec__hd rv">
      <p class="kicker">La plateforme</p>
      <h2 class="display d-lg">Un seul socle,<br>de la première ligne<br>au <span class="em">dernier appel</span>.</h2>
    </div>
    <div class="exp">
      <div class="exp__list rv" id="expList">
        <span class="exp__bar" id="expBar"></span>

        <button class="exp__i" type="button" aria-expanded="true" aria-controls="p1">
          <h3>Construire l’agent</h3>
          <span class="exp__p" id="p1"><p>Identité, missions, garde-fous. En langage clair.</p>
            <span class="go">Prompt · RAG · Outils
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12 5l7 7-7 7"/></svg></span></span>
        </button>

        <button class="exp__i" type="button" aria-expanded="false" aria-controls="p2">
          <h3>Le déployer sur vos numéros</h3>
          <span class="exp__p" id="p2"><p>Nos numéros, votre SIP ou votre CCaaS.</p>
            <span class="go">Téléphone · SIP · Webchat
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12 5l7 7-7 7"/></svg></span></span>
        </button>

        <button class="exp__i" type="button" aria-expanded="false" aria-controls="p3">
          <h3>Tenir la latence sous 600 ms</h3>
          <span class="exp__p" id="p3"><p>L’appelant n’attend jamais son tour de parole.</p>
            <span class="go">STT · RAG · LLM · TTS
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12 5l7 7-7 7"/></svg></span></span>
        </button>

        <button class="exp__i" type="button" aria-expanded="false" aria-controls="p4">
          <h3>Analyser 100 % des appels</h3>
          <span class="exp__p" id="p4"><p>Aucun échantillonnage. Alertes sur vos seuils.</p>
            <span class="go">Live · Analytics · Alertes
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12 5l7 7-7 7"/></svg></span></span>
        </button>
      </div>

      <div class="exp__media rv" style="--d:100ms">
        <div class="pane on">
          <div class="app">
            <div class="app__bar"><i></i><i></i><i></i>
              <b>callem.ai/studio / <em>Assistant Commercial — Acme</em></b></div>
            <div class="app__b">
              <div class="fld"><label>Identité</label>
                <div>Vous êtes un assistant commercial professionnel pour Acme Corp. Ton chaleureux et professionnel.</div></div>
              <div class="fld"><label>Missions</label>
                <div class="foc">Qualifier les leads sur le budget, l’échéance et le pouvoir de décision.</div></div>
              <div class="fld"><label>Garde-fous</label>
                <div class="bare"><span class="gl">
                  <span><svg class="no" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                    stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>Ne jamais confirmer un prix</span>
                  <span><svg class="no" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                    stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>Aucun conseil médical</span>
                  <span><svg class="yes" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5"/></svg>Toujours vérifier l’identité</span>
                </span></div></div>
            </div>
          </div>
          <div class="mini mini--br"><b>Mise en production</b><span class="v">4 j</span>
            <span class="s">du prompt au numéro</span></div>
        </div>

        <div class="pane">
          <div class="app">
            <div class="app__bar"><i></i><i></i><i></i><b>callem.ai/studio / <em>Canaux</em></b></div>
            <div class="app__b">
              <div class="chan">
                <span><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-phone"/></svg>+33 1 84 88 00 00</span>
                <span><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-sip"/></svg>Trunk SIP · actif</span>
                <span><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-chat"/></svg>Webchat · site</span>
                <span><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-campaign"/></svg>Sortant · 50k/j</span>
              </div>
              <div class="fld"><label>Zone de traitement</label><div>eu-west-paris — aucun transit hors UE</div></div>
            </div>
          </div>
          <div class="mini mini--bl"><b>Langues</b><span class="v">25+</span><span class="s">européennes</span></div>
          <div class="mini mini--br"><b>Télécom</b><span class="v">SIP</span><span class="s">en propre</span></div>
        </div>

        <div class="pane">
          <div class="app">
            <div class="app__bar"><i></i><i></i><i></i><b>callem.ai/studio / <em>Latence bout-en-bout</em></b></div>
            <div class="app__b">
              <div class="lat">
                <div><span>STT</span><span class="bar" style="--w:15%"></span><em>90 ms</em></div>
                <div><span>RAG</span><span class="bar" style="--w:13%"></span><em>80 ms</em></div>
                <div><span>LLM</span><span class="bar" style="--w:30%"></span><em>180 ms</em></div>
                <div><span>TTS</span><span class="bar" style="--w:25%"></span><em>150 ms</em></div>
                <div><span>Réseau</span><span class="bar" style="--w:17%"></span><em>100 ms</em></div>
              </div>
            </div>
          </div>
          <div class="mini mini--br"><b>Bout en bout</b><span class="v">~600 ms</span>
            <span class="s">l’appelant n’attend pas</span></div>
        </div>

        <div class="pane">
          <div class="app">
            <div class="app__bar"><i></i><i></i><i></i><b>callem.ai/studio / <em>Analytics</em></b></div>
            <div class="app__b">
              <div class="fld"><label>Appels analysés · 30 jours</label>
                <div class="bare"><span class="spark" id="spark" aria-hidden="true"></span></div></div>
              <div class="chan">
                <span><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-analytics"/></svg>Sentiment · positif 78 %</span>
                <span><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-alert"/></svg>Alerte · seuil 30 %</span>
              </div>
            </div>
          </div>
          <div class="mini mini--bl"><b>Couverture</b><span class="v">100 %</span><span class="s">aucun échantillon</span></div>
          <div class="mini mini--br"><b>Résolus</b><span class="v">70 %</span><span class="s">sans humain</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ SECTEURS ════════════════════════════════════════════════════════ -->
<section class="sec" id="secteurs">
  <div class="wrap">
    <div class="hd-row rv">
      <div class="sec__hd">
        <p class="kicker">Secteurs</p>
        <h2 class="display d-lg">Cinq métiers.<br>Un même <span class="em-v">socle</span>.</h2>
      </div>
      <a class="btn btn--ghost" href="#demo">Parler de votre cas</a>
    </div>
    <div class="sw-shell rv" style="--d:80ms">
      <div class="swiper sw">
      <div class="swiper-wrapper">
        <div class="swiper-slide"><a class="sect__i" href="#demo"><span class="sect__art pic"><img class="" src="https://images.unsplash.com/photo-1616924451835-747bd5cd08ee?auto=format&fit=crop&w=640&q=72" alt="Quartier d’affaires, tours de bureaux" loading="lazy" decoding="async" sizes="(max-width:900px) 90vw, 260px"><b>01</b><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-lock"/></svg></span>
        <span class="sect__b"><h3>Finance</h3><p>Identité vérifiée. Aucun conseil financier.</p></span></a></div>
        <div class="swiper-slide"><a class="sect__i" href="#demo"><span class="sect__art pic"><img class="" src="https://images.unsplash.com/photo-1578991624414-276ef23a534f?auto=format&fit=crop&w=640&q=72" alt="Accueil d’un établissement de santé" loading="lazy" decoding="async" sizes="(max-width:900px) 90vw, 260px"><b>02</b><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-shield"/></svg></span>
        <span class="sect__b"><h3>Santé</h3><p>Rendez-vous et rappels. Zéro conseil médical.</p></span></a></div>
        <div class="swiper-slide"><a class="sect__i" href="#demo"><span class="sect__art pic"><img class="" src="https://images.unsplash.com/photo-1591085686350-798c0f9faa7f?auto=format&fit=crop&w=640&q=72" alt="Cliente dans une boutique" loading="lazy" decoding="async" sizes="(max-width:900px) 90vw, 260px"><b>03</b><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-campaign"/></svg></span>
        <span class="sect__b"><h3>Retail</h3><p>Suivi, retours, réclamations. Pics absorbés.</p></span></a></div>
