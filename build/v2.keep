        <div class="sovmap" id="sovMap">
          <img class="sov__img" src="https://images.unsplash.com/photo-1499856871958-5b9627545d1a?auto=format&fit=crop&w=1200&q=72" alt="Le pont Alexandre-III à Paris au crépuscule" loading="lazy" decoding="async">
          <svg viewBox="0 0 420 250" fill="none" aria-hidden="true" style="position:relative;z-index:2">
