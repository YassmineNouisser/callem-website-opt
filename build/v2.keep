<!-- ═══ DÉMO ════════════════════════════════════════════════════════════ -->
<section class="sec" id="demo">
  <div class="wrap">
    <div class="demo rv" id="demoBox">
      <div class="demo__aside">
        <img class="demo__img" src="https://images.unsplash.com/photo-1523966211575-eb4a01e7dd51?auto=format&fit=crop&w=900&q=72" alt="Un combiné téléphonique posé" loading="lazy" decoding="async">
        <p class="kicker"><i></i>Réserver une démo</p>
        <h2 class="d-md">On vous appelle.<br>Avec un agent.</h2>
        <p style="margin-top:1rem;line-height:1.6">On configure un agent sur votre cas et on vous appelle.</p>
        <ol class="demo__steps">
          <li><b>01</b><span>Vous décrivez l’objectif.</span></li>
          <li><b>02</b><span>On prépare l’agent.</span></li>
          <li><b>03</b><span>Vous recevez l’appel sous 24&nbsp;h.</span></li>
        </ol>
      </div>
      <div class="demo__form">
        <form id="demoForm" novalidate>
          <div class="fgrid">
            <div class="f f--full">
              <label>Objectif de la démo <span class="req">*</span></label>
              <div class="goals" role="group" aria-label="Objectif de la démo">
                <label class="goal"><input type="radio" name="objectif" value="Support client" checked><span>Support client</span></label>
                <label class="goal"><input type="radio" name="objectif" value="Qualification de leads"><span>Qualification de leads</span></label>
                <label class="goal"><input type="radio" name="objectif" value="Prise de rendez-vous"><span>Prise de rendez-vous</span></label>
                <label class="goal"><input type="radio" name="objectif" value="Campagnes sortantes"><span>Campagnes sortantes</span></label>
                <label class="goal"><input type="radio" name="objectif" value="Recouvrement"><span>Recouvrement</span></label>
                <label class="goal"><input type="radio" name="objectif" value="Standard téléphonique"><span>Standard téléphonique</span></label>
              </div>
            </div>
            <div class="f"><label for="nom">Nom et prénom <span class="req">*</span></label>
              <input id="nom" name="nom" type="text" autocomplete="name" placeholder="Camille Dubois" required>
              <span class="err">Indiquez votre nom.</span></div>
            <div class="f"><label for="societe">Société <span class="req">*</span></label>
              <input id="societe" name="societe" type="text" autocomplete="organization" placeholder="Acme SAS" required>
              <span class="err">Indiquez votre société.</span></div>
            <div class="f"><label for="email">E-mail professionnel <span class="req">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" placeholder="camille@acme.fr" required>
              <span class="err">Adresse e-mail invalide.</span></div>
            <div class="f"><label for="tel">Téléphone <span class="req">*</span></label>
              <input id="tel" name="telephone" type="tel" autocomplete="tel" placeholder="+33 6 12 34 56 78" required>
              <span class="err">Numéro invalide.</span></div>
            <div class="f f--full"><label for="secteur">Secteur</label>
              <select id="secteur" name="secteur"><option value="">Sélectionner…</option>
                <option>Finance</option><option>Santé</option><option>Retail</option>
                <option>Assurance</option><option>Pouvoirs publics</option><option>Autre</option></select></div>
            <div class="f f--full"><label for="ctx">Votre scénario</label>
              <textarea id="ctx" name="contexte" placeholder="Ex. : suivi de commande, 400 appels par jour."></textarea></div>
          </div>
          <div class="demo__submit">
            <button class="btn btn--primary btn--lg" type="submit">Demander l’appel de démo</button>
            <p class="demo__legal">Réponse sous 24&nbsp;h. Sans engagement.</p>
          </div>
        </form>
        <div class="done" id="done" role="status">
          <div class="done__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5"/></svg></div>
          <h3 class="d-md">Demande enregistrée.</h3>
          <p style="margin-top:.8rem">Un agent vous appelle sous 24&nbsp;h.</p>
        </div>
      </div>
    </div>
  </div>
</section>
</main>

