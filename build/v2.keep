      <span class="foot__badge"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-lock"/></svg>Datacenter Paris</span>
      <span class="foot__badge"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-leaf"/></svg>Énergie française bas carbone</span>
