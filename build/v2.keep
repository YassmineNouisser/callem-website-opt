              <circle class="ring core" r="30" fill="rgba(139,60,247,.14)" stroke="rgba(139,60,247,.5)"/>
              <circle class="ring" r="62"/>
              <circle class="ring ring--d" r="94"/>
              <circle class="ring" r="124" stroke="rgba(255,255,255,.18)"/>
              <g class="pkt"><circle cx="0" cy="-62" r="5" fill="var(--violet)"/></g>
              <g class="pkt"><circle cx="54" cy="31" r="4" fill="rgba(139,60,247,.65)"/></g>
              <g class="pkt2"><circle cx="-94" cy="0" r="4.5" fill="var(--orange)"/></g>
              <g class="pkt2"><circle cx="66" cy="66" r="3.6" fill="rgba(235,106,10,.7)"/></g>
              <g class="out"><circle r="4.5" fill="rgba(255,255,255,.75)"/></g>
              <text x="0" y="5" text-anchor="middle" font-family="JetBrains Mono,monospace"
                font-size="12" fill="#fff" letter-spacing="1">PARIS</text>
              <text x="0" y="-134" text-anchor="middle" font-family="JetBrains Mono,monospace"
                font-size="10" fill="rgba(255,255,255,.6)" letter-spacing="2">PÉRIMÈTRE UE — RIEN NE SORT</text>
            </g>
          </svg>
        </div>
      </div>
      <div class="rv" style="--d:100ms">
        <div class="pass__card">
          <p class="pass__hd"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-eu"/></svg>Fiche de conformité</p>
          <dl class="pass__l">
            <dt>Traitement</dt><dd>eu-west-paris</dd>
            <dt>Transit</dt><dd><em>0</em> donnée hors Union européenne</dd>
            <dt>Entraînement</dt><dd>Aucune donnée d’entraînement</dd>
