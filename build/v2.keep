<main id="main">
<span id="top"></span>

<!-- ═══ HÉROS ═══════════════════════════════════════════════════════════ -->
<section class="hero" id="hero">
 <div class="hero__rail" id="heroRail">
  <div class="hero__pin" id="heroPin">
   <canvas class="field" id="field" aria-hidden="true"></canvas>
   <div class="hero__veil" aria-hidden="true"></div>
   <figure class="shot" id="shot">
  <video id="heroVid" class="shot__v" autoplay loop muted playsinline preload="auto"
       poster="https://images.unsplash.com/photo-1560264418-c4445382edbc?auto=format&fit=crop&w=1200&q=70"
       aria-label="Une équipe de supervision devant ses écrans">
    <source src="https://videos.pexels.com/video-files/8865868/8865868-hd_1280_720_25fps.mp4" type="video/mp4">
    <source src="https://videos.pexels.com/video-files/8865868/8865868-sd_640_360_25fps.mp4" type="video/mp4">
  </video>
  <span class="shot__scrim"></span>
  <span class="shot__live"><i></i>Appel en cours</span>
 </figure>

   <div class="hero__grid"><div class="wrap" style="width:100%">
    <div class="hero__copy" id="heroCopy">
      <p class="kicker"><i></i>Agents vocaux IA · Paris</p>
      <h1 class="d-xl">Vos appels,<br>résolus.<br><span class="grad">Supervisés.</span></h1>
      <p class="hero__sub lede">Traités de bout en bout. Supervisés en direct, depuis Paris.</p>
      <div class="hero__btns">
        <a class="btn btn--primary btn--lg" href="#demo">Réserver une démo</a>
        <a class="btn btn--ghost btn--lg" href="#plateforme">Voir la plateforme</a>
      </div>
      <div class="hero__proof">
        <div><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-eu"/></svg>
          Traitement et stockage en France</div>
        <div><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-shield"/></svg>
          Conforme AI&nbsp;Act article&nbsp;50</div>
      </div>
    </div>
   </div></div>

   <p class="sr">Démonstration animée d’un appel client résolu par un agent Callem en 41 secondes, à Paris.</p>

   <div class="listen" id="listen">
     <span class="listen__b" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
     <span><b>Agent en ligne</b><br><span id="listenT">à l’écoute · fr-FR</span></span>
   </div>

   <div class="stackw" id="stack">
     <div class="bb" id="q1">
       <svg class="bb__av" viewBox="0 0 40 40" aria-hidden="true"><use href="#av"/></svg>
       <span><b>Appelant · 00:02</b><p>« Ma commande #4521 a trois jours de retard. »</p></span>
     </div>
     <div class="bb" id="q2">
       <svg class="bb__av" viewBox="0 0 127 127" aria-hidden="true"><use href="#callem-mark"/></svg>
       <span><b>Agent Callem · 00:06</b><p>« Je suis un assistant Callem pour Acme. Je vérifie tout de suite. »</p></span>
     </div>
     <div class="bb bb--tool" id="q3">
       <span class="bb__d"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-tools"/></svg></span>
       <span><p>crm.get_order(#4521)</p><em>82 ms</em></span>
     </div>
     <div class="bb bb--tool" id="q4">
       <span class="bb__d"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-chat"/></svg></span>
       <span><p>sms.send(tracking)</p><em>140 ms</em></span>
     </div>
     <div class="bb bb--tool bb--ok" id="q5">
       <span class="bb__d"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5"/></svg></span>
       <span><p>Résolu sans humain</p><em>00:41</em></span>
     </div>
   </div>

   <p class="payoff" id="payoff"><b>Un appel. Résolu en 41 secondes.<br>Supervisé, depuis Paris.</b>
     <span>Callem · eu-west-paris</span></p>

   <div class="acts"><div class="wrap"><div class="acts__g" id="acts">
     <button class="act on" type="button" data-step="1">01 · L’appel entre<span class="act__fill"></span></button><button class="act" type="button" data-step="2">02 · L’IA comprend<span class="act__fill"></span></button>
     <button class="act" type="button" data-step="3">03 · L’outil agit<span class="act__fill"></span></button><button class="act" type="button" data-step="4">04 · Résolu, en France<span class="act__fill"></span></button>
   </div></div></div>
  </div>
 </div>
</section>

